rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'habitsk50@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Subcategories
    match /subcategories/{subcategoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Posts
    match /posts/{postId} {
      allow read: if true;
      allow write: if true;
    }

    // Quizzes
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if true;
    }

    // Quiz Questions
    match /quizQuestions/{questionId} {
      allow read: if true;
      allow write: if true;
    }

    // App Settings
    match /appSettings/{settingsId} {
      allow read: if true;
      allow write: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
